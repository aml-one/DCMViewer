<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AmL.DCMViewer</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <MergeToSingleDll>false</MergeToSingleDll>
    <SingleDllOutputDir>$(MSBuildProjectDirectory)\..\publish\single</SingleDllOutputDir>
    <SingleDllOutputFile>$(SingleDllOutputDir)\AmL.DCMViewer.dll</SingleDllOutputFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\clearmeasurement.png" />
    <None Remove="Images\clipping.png" />
    <None Remove="Images\finish.png" />
    <None Remove="Images\measurement.png" />
    <None Remove="Images\merge.png" />
    <None Remove="Images\model.png" />
    <None Remove="Images\scan.png" />
    <None Remove="Images\abutment.png" />
    <None Remove="Images\restoration.png" />
    <None Remove="Images\export.png" />
    <None Remove="Images\perspective.png" />
    <None Remove="Images\sectionmode.png" />
    <None Remove="Images\turnoffsection.png" />
    <None Remove="Images\zoomtofit.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="inspector_temp\**\*.cs" />
    <EmbeddedResource Remove="inspector_temp\**\*" />
    <None Remove="inspector_temp\**\*" />
    <Page Remove="inspector_temp\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.27.3" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\clearmeasurement.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\clipping.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\finish.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\measurement.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\merge.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\model.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\scan.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\abutment.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\restoration.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\export.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\perspective.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\sectionmode.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\turnoffsection.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\zoomtofit.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <Target Name="CreateSingleMergedDll"
          AfterTargets="Build"
          Condition="'$(MergeToSingleDll)' == 'true'">
    <ItemGroup>
      <MergeAssemblies Include="$(TargetPath)" />
      <MergeAssemblies Include="$(OutputPath)HelixToolkit.Wpf.dll" />
      <MergeAssemblies Include="$(OutputPath)BouncyCastle.Cryptography.dll" />
    </ItemGroup>

    <MakeDir Directories="$(SingleDllOutputDir)" />

    <ILRepack InputAssemblies="@(MergeAssemblies)"
              OutputFile="$(SingleDllOutputFile)"
              Internalize="true"
              TargetKind="SameAsPrimaryAssembly"
              Parallel="true"
              DebugInfo="true" />

        <Copy SourceFiles="$(TargetDir)$(AssemblyName).xml"
          DestinationFiles="$(SingleDllOutputDir)\$(AssemblyName).xml"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(AssemblyName).xml')" />

    <Message Importance="High"
             Text="Single merged DLL created: $(SingleDllOutputFile)" />
  </Target>

</Project>
